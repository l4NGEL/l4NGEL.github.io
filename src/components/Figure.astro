---
// Görsel ya da (slot ile) SVG şema + alt yazı.
interface Props {
  caption: string;
  src?: string;
  alt?: string;
}

const { caption, src, alt } = Astro.props;
---
<figure>
  {src ? (
    <img src={src} alt={alt ?? caption} loading="lazy" decoding="async" />
  ) : (
    <div class="fig-frame box"><div class="fig-scroll"><slot /></div></div>
  )}
  <figcaption>{caption}</figcaption>
</figure>
