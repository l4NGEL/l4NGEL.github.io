---
// Küçük, tek renkli arayüz ikonları. GitHub işareti Simple Icons'tan (CC0).
import { siGithub } from 'simple-icons';

interface Props {
  name: 'mail' | 'github' | 'linkedin' | 'doc' | 'badge' | 'copy' | 'arrow' | 'up' | 'folder' | 'briefcase' | 'cap';
  size?: number;
}
const { name, size = 18 } = Astro.props;
---
<svg class="ic" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  {name === 'github' && <path fill="currentColor" d={siGithub.path} />}
  {name === 'linkedin' && (
    <g fill="currentColor">
      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zM9.5 9.75h3.8v1.5h.06c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.77 2.52 4.77 5.8v5.65h-4v-5c0-1.2-.02-2.73-1.72-2.73-1.73 0-2 1.3-2 2.64v5.09h-4z" />
    </g>
  )}
  {name === 'mail' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </g>
  )}
  {name === 'doc' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
      <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" />
    </g>
  )}
  {name === 'badge' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
      <circle cx="12" cy="9" r="6" /><path d="m8.5 13.8-1.5 7.2 5-2.5 5 2.5-1.5-7.2" /><path d="m9.8 9 1.5 1.5 3-3" />
    </g>
  )}
  {name === 'folder' && (
    <path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
  )}
  {name === 'copy' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
      <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
    </g>
  )}
  {name === 'arrow' && (
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M9 7h8v8" />
  )}
  {name === 'briefcase' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
      <rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 12h18" />
    </g>
  )}
  {name === 'cap' && (
    <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round">
      <path d="m2 9 10-5 10 5-10 5z" /><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5M22 9v5" />
    </g>
  )}
  {name === 'up' && (
    <path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M12 19V5M6 11l6-6 6 6" />
  )}
</svg>
