---
import '../styles/global.css';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const onWork = path.startsWith('/projeler');
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;500&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
      // Kaydırınca belirme efektleri için içeriği ilk boyamadan önce gizle.
      // Betik yüklenmezse 2.5 sn sonra her şey görünür olur.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
        setTimeout(() => {
          const cl = document.documentElement.classList;
          if (!cl.contains('motion-ready')) cl.add('motion-fallback');
        }, 2500);
      }
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <nav class="menu" aria-label="Site">
          <a href="/" class="menu-home" aria-current={path === '/' ? 'page' : undefined}>Ana sayfa</a>
          <a href="/projeler" aria-current={onWork ? 'page' : undefined}>Projeler</a>
          <a href="/sertifikalar" aria-current={path === '/sertifikalar' ? 'page' : undefined}>Sertifikalar</a>
          <a href="/hakkimda" aria-current={path === '/hakkimda' ? 'page' : undefined}>Hakkımda</a>
          <button class="theme" id="theme" type="button" aria-label="Açık/koyu tema">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M7 1a6 6 0 0 1 0 12z" fill="currentColor"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <div class="progress" aria-hidden="true"></div>

    <slot />

    <footer class="foot">
      <div class="wrap foot-grid">
        <div class="foot-intro">
          <p class="foot-name">Beyza Nur Kılıç</p>
          <p class="foot-role">Bilgisayar mühendisi · Ankara</p>
          <p class="foot-note">Bir proje, pozisyon ya da soru için yazabilirsiniz.</p>
          <a class="foot-mail" href="mailto:byznrklc01@gmail.com">byznrklc01@gmail.com</a>
        </div>
        <nav class="foot-col" aria-label="Sayfalar">
          <p class="label">Sayfalar</p>
          <ul>
            <li><a href="/">Ana sayfa</a></li>
            <li><a href="/projeler">Projeler</a></li>
            <li><a href="/sertifikalar">Sertifikalar</a></li>
            <li><a href="/hakkimda">Hakkımda</a></li>
          </ul>
        </nav>
        <div class="foot-col">
          <p class="label">Bağlantılar</p>
          <ContactLinks variant="foot" />
        </div>
      </div>
      <div class="wrap foot-bar">
        <span>© {new Date().getFullYear()} Beyza Nur Kılıç</span>
        <a href="#" class="to-top" data-top><Icon name="up" size={15} /> Yukarı çık</a>
      </div>
    </footer>

    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
