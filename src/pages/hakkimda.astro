---
import Base from '../layouts/Base.astro';
import { CERTIFICATES } from '../certificates';
import { ROLES } from '../experience';

const skills = [
  ['Diller', 'Python, C++17, C#, Java, TypeScript, Rust, Dart, SQL'],
  ['Görü ve ML', 'PyTorch, YOLOv8, OSNet Re-ID, OpenCV, ONNX Runtime, CUDA, Whisper, Transformers, PEFT/QLoRA, DPO, scikit-learn'],
  ['Sistem ve ağ', 'WPF/MVVM, ASP.NET Core, SignalR, ROS2, MQTT, Protobuf, FRRouting/OSPF, SDN, MAVLink, SNMP, NetFlow'],
  ['Web ve mobil', 'React, React Native/Expo, Flutter, Node.js, FastAPI, PostgreSQL/PostGIS, Redis, Firebase'],
  ['Altyapı', 'Docker, GitHub Actions, GitLab CI, Jenkins, Testcontainers, MLflow, Linux'],
];
---
<Base title="Hakkımda · Beyza Nur Kılıç" description="Beyza Nur Kılıç: deneyim, eğitim ve teknik beceriler.">
  <main class="wrap">
    <header class="p-top">
      <p class="crumb">Özgeçmiş</p>
      <h1 class="p-title">Hakkımda</h1>
      <div class="p-lead">
        <p class="lead">
          Bilgisayar mühendisiyim. Papilon Savunma'da web, mobil ve backend tarafında çalışıyorum.
          Kendi projelerim bilgisayarlı görü, konuşma, dil modelleri ve operatör yazılımları.
        </p>
        <dl class="facts">
          <dt>Konum</dt><dd>Ankara</dd>
          <dt>Diller</dt><dd>Türkçe (ana dil), İngilizce (B2), Almanca (A1)</dd>
          <dt>E-posta</dt><dd><a href="mailto:byznrklc01@gmail.com">byznrklc01@gmail.com</a></dd>
        </dl>
      </div>
    </header>

    <div class="shead"><h2>Deneyim</h2><span class="label">Ekran görüntüleri talep üzerine</span></div>
    {ROLES.map((r) => (
      <article class="role-row">
        <div>
          <p class="when">{r.when}</p>
          <p class="org">{r.company} · {r.place}</p>
        </div>
        <div>
          <h3>{r.title}</h3>
          <p class="sum">{r.summary}</p>
          <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
          <p class="stack-line">{r.stack.join(' · ')}</p>
        </div>
      </article>
    ))}

    <div class="shead"><h2>Eğitim</h2></div>
    <ul class="cv-list">
      <li>
        <span class="when">2026 · devam</span>
        <div><b>Yapay Zekâ Destekli Kodlama, Önlisans</b><p>Anadolu Üniversitesi, Açıköğretim Fakültesi</p><p>1. dönem · Makine Öğrenmesi, Modern Yazılım Geliştirme</p></div>
      </li>
      <li>
        <span class="when">2021 · 2025</span>
        <div><b>Bilgisayar Mühendisliği, Lisans</b><p>Bursa Uludağ Üniversitesi · GPA 3.40 / 4.00</p><p>Bitirme projesi: <a href="/projeler/yuz-tanima" style="color:var(--accent-ink)">Derin öğrenme ile yüz tanıma</a> (danışman Prof. Dr. Kemal Fidanboylu)</p></div>
      </li>
    </ul>

    <div class="shead"><h2>Sertifikalar</h2><a class="readmore" style="margin:0" href="/sertifikalar">Belgeler ve doğrulama →</a></div>
    <ul class="cv-list">
      {CERTIFICATES.map((c) => (
        <li>
          <span class="when">{c.date || '·'}</span>
          <div>
            <b>{c.slug ? <a href={`/sertifikalar/${c.slug}`} style="color:inherit">{c.title}</a> : c.title}</b>
            <p>{c.issuer}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="shead"><h2>Nasıl çalışıyorum</h2></div>
    <div class="cols" style="margin-top:24px">
      <p class="label">Kısaca</p>
      <div class="prose">
        <p>
          Bir sonucu kabul etmeden önce, onu üretmemiş veriyle yeniden ölçüyorum. AutoTrack'te bir düzeltme tek
          sekansta işe yarıyor gibi görünüyordu; yedi sekansa genişletince toplamda zarar verdiği ortaya çıktı ve
          sebebini (kare hızına kör bir mesafe eşiği) bulup düzelttim. Stereo 3D MOT'ta hedefleri baştan yazdım,
          çoğu tutmadı ve rapor bunu söylüyor.
        </p>
        <p>
          Bir fikri gerçek koda almadan önce küçük ve izole bir deneyde deniyorum. Ölçüm araçlarımın kendisinde de
          hata arıyorum: projelerimdeki en öğretici hataların birkaçı, değerlendirme betiklerinin içindeydi.
        </p>
      </div>
    </div>

    <div class="shead"><h2>Teknik beceriler</h2></div>
    <ul class="cv-list">
      {skills.map(([k, v]) => (
        <li><span class="when">{k}</span><div><p style="margin:0;color:var(--ink)">{v}</p></div></li>
      ))}
    </ul>
  </main>
</Base>
