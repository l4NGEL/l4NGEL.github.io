---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { GROUPS, type Group } from '../categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = (Object.keys(GROUPS) as Group[])
  .map((g) => ({ key: g, title: GROUPS[g], items: projects.filter((p) => p.data.group === g) }))
  .filter((g) => g.items.length > 0);
---
<Base
  title="Beyza Nur Kılıç"
  description="Bilgisayar mühendisi. Görüntü işleme, ses ve sistem yazılımı üzerine projeler."
  image="/images/autotrack/demo.webp"
>
  <main>
    <h1>Merhaba, ben Beyza.</h1>
    <p>
      Bilgisayar mühendisiyim. Ankara'da, Papilon Savunma'da full-stack geliştirici olarak çalışıyorum;
      işte daha çok web, mobil ve backend tarafındayım.
    </p>
    <p>
      Kendi projelerimde ise görüntü ve ses tarafıyla uğraşmayı seviyorum: nesne takibi, stereo derinlik,
      konuşma tanıma, bir de bunların etrafındaki operatör arayüzleri ve ağ işleri. Aşağıda bunların notları var.
      Sonuçları olduğu gibi yazdım, tutmayanlar da dahil.
    </p>
    <p class="now">Şu sıralar: <a href="/projeler/nabiz">NABIZ</a>'ın C++ tarafı. Makine sesinden arıza tespiti yapan bir proje.</p>

    {groups.map((g) => (
      <section class="group">
        <h2>{g.title}</h2>
        <ul class="plist">
          {g.items.map((p) => (
            <li>
              {p.data.thumb && <img class="thumb" src={p.data.thumb} alt="" loading="lazy" />}
              <a class="t" href={`/projeler/${p.id}`}>{p.data.title}</a>
              {p.data.wip && <small> (devam ediyor)</small>}
              <p class="d">{p.data.description}</p>
              <p class="m">
                {p.data.date} · {p.data.stack.slice(0, 4).join(', ')}
                {p.data.repo && <> · <a href={p.data.repo} rel="noopener">kod</a></>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Base>
