---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import Metrics from '../components/Metrics.astro';
import { DIAGRAMS } from '../diagrams';
import { CATEGORIES, type Category } from '../categories';
import { CERTIFICATES } from '../certificates';
import { ROLES } from '../experience';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const count = (c: Category) => projects.filter((p) => p.data.categories.includes(c)).length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title="Beyza Nur Kılıç · Bilgisayar Mühendisi"
  description="Bilgisayarlı görü, yapay zekâ, savunma ve sistem yazılımı üzerine projeler."
  image="/images/autotrack/demo.webp"
>
  <main>
    <section class="masthead">
      <div class="wrap">
        <h1>Beyza Nur Kılıç</h1>
        <p class="role">Bilgisayar Mühendisi · Bilgisayarlı görü, yapay zekâ ve sistem yazılımı</p>
        <div class="intro">
          <div>
            <p class="label">Şu an</p>
            <p>Papilon Savunma'da junior full-stack geliştirici. Bursa Uludağ Üniversitesi Bilgisayar Mühendisliği mezunu, Ankara'da.</p>
          </div>
          <div>
            <p class="label">Ne yapıyorum</p>
            <p class="lead">
              Kameradan gelen görüntüyü anlamlandıran görü sistemleri, sahada internetsiz çalışan modeller ve
              bunları kullanan operatör arayüzleri geliştiriyorum. Bir şeyin çalıştığını söylemeden önce ölçüyorum;{" "}
              <em>ölçüm beklediğim gibi çıkmadığında da onu yazıyorum.</em>
            </p>
          </div>
          <div>
            <p class="label">Bağlantılar</p>
            <ul class="linklist">
              <li><a href="mailto:byznrklc01@gmail.com">E-posta</a></li>
              <li><a href="https://github.com/l4NGEL" rel="noopener">GitHub</a></li>
              <li><a href="https://www.linkedin.com/in/beyza-nur-kili%C3%A7/" rel="noopener">LinkedIn</a></li>
              <li><a href="/hakkimda">Özgeçmiş</a></li>
              <li><a href="/sertifikalar">Sertifikalar</a></li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <div class="wrap">
      <div class="shead">
        <h2>Deneyim</h2>
        <span class="label">Şirket içi projeler; ekran görüntüleri talep üzerine</span>
      </div>
      {ROLES.map((r) => (
        <article class="role-row">
          <div>
            <p class="when">{r.when}</p>
            <p class="org">{r.company} · {r.place}</p>
          </div>
          <div>
            <h3>{r.title}</h3>
            <p class="sum">{r.summary}</p>
            <ul>{r.points.map((p) => <li>{p}</li>)}</ul>
            <p class="stack-line">{r.stack.join(' · ')}</p>
          </div>
        </article>
      ))}

      <div class="shead">
        <h2>Seçili çalışmalar</h2>
        <span class="label">{featured.length} proje</span>
      </div>

      {featured.map((p, i) => {
        const d = p.data;
        const Diagram = d.diagram ? DIAGRAMS[d.diagram as keyof typeof DIAGRAMS] : undefined;
        return (
          <article class:list={['work', { flip: i % 2 === 1 }]}>
            <div class="work-text">
              <span class="work-no">{d.categories.map((c) => CATEGORIES[c]).join(' · ')}</span>
              <h3><a href={`/projeler/${p.id}`}>{d.title}</a></h3>
              <p class="sum">{d.summary}</p>
              <dl class="facts">
                <dt>Dönem</dt><dd>{d.period}</dd>
                <dt>Teknoloji</dt><dd>{d.stack.slice(0, 6).join(', ')}</dd>
                <dt>Kod</dt><dd>{d.repo ? 'GitHub, açık' : 'Talep üzerine'}</dd>
              </dl>
              <a class="readmore" href={`/projeler/${p.id}`}>Projenin ayrıntıları →</a>
            </div>
            <div>
              {Diagram ? (
                <Figure caption={d.tagline}><Diagram /></Figure>
              ) : d.cover ? (
                <Figure src={d.cover.src} alt={d.cover.alt} caption={d.cover.alt} bare />
              ) : null}
              <Metrics items={d.metrics} />
            </div>
          </article>
        );
      })}

      <div class="shead">
        <h2>Tüm projeler</h2>
        <span class="label">{projects.length} proje</span>
      </div>
      <div class="filters" id="filters" role="group" aria-label="Alana göre filtrele">
        <button type="button" data-f="all" aria-pressed="true">Tümü<sup>{projects.length}</sup></button>
        {(Object.keys(CATEGORIES) as Category[]).map((c) => (
          <button type="button" data-f={c} aria-pressed="false">{CATEGORIES[c]}<sup>{count(c)}</sup></button>
        ))}
      </div>
      <ol class="index">
        {projects.map((p) => (
          <li data-cat={p.data.categories.join(' ')}>
            <a class="row" href={`/projeler/${p.id}`}>
              <span class="n">{pad(p.data.order)}</span>
              <span class="t">{p.data.title}</span>
              <span class="d">{p.data.tagline}</span>
              <span class="m">
                {p.data.status ? <span class="tag-status">{p.data.status}</span> : p.data.year}
                {' · '}{p.data.repo ? 'açık kaynak' : 'özel repo'}
              </span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>

      <div class="shead">
        <h2>Sertifikalar</h2>
        <a class="readmore" style="margin:0" href="/sertifikalar">Tümü ve belgeler →</a>
      </div>
      <ul class="cert-list">
        {CERTIFICATES.filter((c) => c.year).map((c) => (
          <li>
            <b>{c.title}</b>
            <span class="i">{c.issuer} · {c.date}</span>
            <span class="v">{c.verify ? <a href={c.verify} target="_blank" rel="noopener">Doğrula ↗</a> : <a href="/sertifikalar">Belge</a>}</span>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <script>
    const rows = [...document.querySelectorAll<HTMLElement>('.index li')];
    const btns = [...document.querySelectorAll<HTMLButtonElement>('#filters button')];
    for (const b of btns) {
      b.addEventListener('click', () => {
        const f = b.dataset.f!;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        rows.forEach((r) => (r.hidden = f !== 'all' && !r.dataset.cat!.split(' ').includes(f)));
      });
    }
  </script>
</Base>
