---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES, type Category } from '../categories';
import { CERTIFICATES } from '../certificates';
import Timeline from '../components/Timeline.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import TechStrip from '../components/TechStrip.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
// Sertifikaları bitiş tarihine göre yeniden eskiye sırala; ana sayfada yalnız en yenileri
const AYLAR = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'];
const certKey = (date: string, year: number) => {
  const m = [...date.matchAll(/(\p{L}+) (\d{4})/gu)].pop();
  return m ? Number(m[2]) * 12 + AYLAR.indexOf(m[1]) : year * 12;
};
const latestCerts = CERTIFICATES.filter((c) => c.year).sort((a, b) => certKey(b.date, b.year) - certKey(a.date, a.year)).slice(0, 6);
const recent =projects.filter((p) => !p.data.featured).sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order).slice(0, 6);
---
<Base
  title="Beyza Nur Kılıç · Bilgisayar Mühendisi"
  description="Bilgisayarlı görü, yapay zekâ, savunma ve sistem yazılımı üzerine projeler."
  image="/images/autotrack/demo.webp"
>
  <main>
    <section class="masthead hero">
      <HeroCanvas />
      <div class="wrap hero-inner">
        <div class="hero-grid">
          <div class="hero-main">
            <p class="eyebrow"><span class="dot" aria-hidden="true"></span>Bilgisayar Mühendisi · Ankara</p>
            <h1>Beyza Nur Kılıç</h1>
            <ul class="hero-meta">
              <li><Icon name="briefcase" size={16} />Junior Full-Stack Developer, Papilon Savunma</li>
              <li><Icon name="cap" size={16} />Bilgisayar Mühendisliği, Bursa Uludağ Üniversitesi</li>
              <li><Icon name="cap" size={16} />Yapay Zekâ Destekli Kodlama, Anadolu Üniversitesi · devam</li>
            </ul>
            <div class="hero-cta">
              <a class="btn btn-primary" href="/projeler">Projeleri incele <Icon name="arrow" size={15} /></a>
              <a class="btn" href="mailto:byznrklc01@gmail.com" data-copy="byznrklc01@gmail.com"><Icon name="mail" size={16} /><span class="btn-label">İletişime geç</span></a>
              <a class="btn btn-ghost" href="/hakkimda">Özgeçmiş</a>
            </div>
            <dl class="hero-stats">
              <div><dt>Proje</dt><dd>{projects.length}</dd></div>
              <div><dt>Açık kaynak</dt><dd>{projects.filter((p) => p.data.repo).length}</dd></div>
              <div><dt>Sertifika</dt><dd>{CERTIFICATES.length}</dd></div>
            </dl>
          </div>
          <aside class="hero-card" aria-label="İletişim">
            <p class="label">İletişim</p>
            <ContactLinks />
          </aside>
        </div>
      </div>
      <div class="hero-foot">
        <TechStrip />
      </div>
    </section>

    <div class="wrap" id="icerik">
      <div class="shead">
        <h2>Deneyim</h2>
        <span class="label">Şirket içi projeler; ekran görüntüleri talep üzerine</span>
      </div>
      <Timeline />

      <div class="shead">
        <h2>Seçili çalışmalar</h2>
        <span class="label">{featured.length} proje</span>
      </div>
      <div class="fgrid">
        {featured.map((p) => {
          const d = p.data;
          return (
            <a class="fcard" href={`/projeler/${p.id}`}>
              {d.cover && <img class="fcard-img" src={d.cover.src} alt={d.cover.alt} loading="lazy" decoding="async" />}
              <div class="fcard-body">
                <span class="work-no">{d.categories.map((c) => CATEGORIES[c]).join(' · ')}</span>
                <h3 style={`view-transition-name: p-${p.id}`}>{d.title}</h3>
                <p class="fcard-sum">{d.tagline}</p>
                <dl class="fcard-metrics">
                  {d.metrics.slice(0, 2).map((m) => <div><dd>{m.value}</dd><dt>{m.label}</dt></div>)}
                </dl>
                <p class="fcard-foot">
                  <span>{d.period} · {d.repo ? 'GitHub, açık' : 'kod talep üzerine'}</span>
                  <span class="fcard-go" aria-hidden="true">→</span>
                </p>
              </div>
            </a>
          );
        })}
      </div>

      <div class="shead">
        <h2>Diğer projeler</h2>
        <a class="readmore" style="margin:0" href="/projeler">Tüm projeler ({projects.length}) →</a>
      </div>
      <div class="mgrid">
        {recent.map((p) => {
          const d = p.data;
          const img = d.thumb ?? d.cover?.src;
          return (
            <a class="mcard" href={`/projeler/${p.id}`}>
              {img ? <img class="mcard-img" src={img} alt="" loading="lazy" decoding="async" /> : <span class="mcard-img mcard-ph" aria-hidden="true">{d.stack[0]}</span>}
              <span class="mcard-t" style={`view-transition-name: p-${p.id}`}>{d.title}</span>
              <span class="mcard-d">{d.tagline}</span>
              <span class="mcard-m">{d.status ? <span class="tag-status">{d.status}</span> : d.year} · {d.repo ? 'açık kaynak' : 'özel repo'}</span>
            </a>
          );
        })}
      </div>
      <p style="margin:22px 0 0"><a class="readmore" href="/projeler">Bütün projeleri alana göre filtreleyerek gör →</a></p>

      <div class="shead">
        <h2>Sertifikalar</h2>
        <a class="readmore" style="margin:0" href="/sertifikalar">Tümü ({CERTIFICATES.length}) ve belgeler →</a>
      </div>
      <ul class="cert-list">
        {latestCerts.map((c) => (
          <li>
            <b>{c.title}</b>
            <span class="i">{c.issuer} · {c.date}</span>
            <span class="v">{c.verify ? <a href={c.verify} target="_blank" rel="noopener">Doğrula ↗</a> : c.slug ? <a href={`/sertifikalar/${c.slug}`}>Sertifikalar</a> : <a href="/sertifikalar">Belge</a>}</span>
          </li>
        ))}
      </ul>
    </div>
  </main>

</Base>
