---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { CATEGORIES, type Category } from '../categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
const count = (c: Category) => projects.filter((p) => p.data.categories.includes(c)).length;
---
<Base
  title="Beyza Nur Kılıç — Bilgisayar Mühendisi"
  description="Bilgisayarlı görü, yapay zekâ, savunma/sistem yazılımı ve full-stack projeleri."
  image="/images/autotrack/demo.webp"
>
  <header class="hero">
    <div class="wrap">
      <h1><span class="bracket">Beyza Nur Kılıç</span></h1>
      <p class="role">Bilgisayar Mühendisi — bilgisayarlı görü, yapay zekâ ve sistem yazılımı</p>
      <p class="lede">
        Algılamadan karar desteğine uzanan uçtan uca sistemler kuruyorum: C++/CUDA görü hatları, çoklu hedef
        takibi, LLM/RAG ve konuşma tanıma modelleri, .NET/WPF operatör arayüzleri ve bunları besleyen backend
        servisleri. Her projede sonuçları önceden belirlenmiş ölçütlerle ölçüp, tutmayanları da raporluyorum.
      </p>
      <div class="contact">
        <a href="mailto:byznrklc01@gmail.com">byznrklc01@gmail.com</a>
        <a href="https://github.com/l4NGEL" rel="noopener">github.com/l4NGEL</a>
        <a href="https://www.linkedin.com/in/beyza-nur-kili%C3%A7/" rel="noopener">LinkedIn</a>
      </div>
      <div class="meta">
        <span>Ankara</span>
        <span>Papilon Savunma — Junior Full-Stack Developer</span>
        <span>Bursa Uludağ Üni. Bilgisayar Müh.</span>
      </div>
    </div>
  </header>

  <nav class="bar" aria-label="Proje filtresi">
    <div class="wrap filters" id="filters" style="padding-left:20px;padding-right:20px">
      <button type="button" data-f="all" aria-pressed="true">Tümü<span class="n">{projects.length}</span></button>
      {(Object.keys(CATEGORIES) as Category[]).map((c) => (
        <button type="button" data-f={c} aria-pressed="false">
          {CATEGORIES[c]}<span class="n">{count(c)}</span>
        </button>
      ))}
    </div>
  </nav>

  <main class="wrap">
    <section>
      <h2>Öne çıkanlar</h2>
      <p class="sub">En kapsamlı ve en sıkı doğrulanmış projeler.</p>
      <div class="grid featured">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>

    <section>
      <h2>Diğer projeler</h2>
      <p class="sub">Durum etiketi olmayanlar tamamlanmış ve çalıştırılmış projelerdir. Karta tıklayınca detay sayfası açılır.</p>
      <div class="grid">
        {rest.map((p) => <ProjectCard project={p} />)}
      </div>
    </section>
  </main>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('.card')];
    const btns = [...document.querySelectorAll<HTMLButtonElement>('#filters button')];
    for (const b of btns) {
      b.addEventListener('click', () => {
        const f = b.dataset.f!;
        btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        cards.forEach((c) => (c.hidden = f !== 'all' && !c.dataset.cat!.split(' ').includes(f)));
        document.querySelectorAll<HTMLElement>('main section').forEach((s) => {
          s.hidden = ![...s.querySelectorAll<HTMLElement>('.card')].some((c) => !c.hidden);
        });
      });
    }
  </script>
</Base>
