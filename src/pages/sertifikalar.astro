---
import Base from '../layouts/Base.astro';
import { CERTIFICATES } from '../certificates';

const AREAS = ['Ağ ve güvenlik', 'Yazılım', 'Yapay zekâ', 'Yönetim', 'Dil'] as const;
const docs = CERTIFICATES.filter((c) => c.image || c.parts).sort((a, b) => b.year - a.year);
const others = CERTIFICATES.filter((c) => !c.image && !c.parts?.length);
const verifiable = CERTIFICATES.filter((c) => c.verify).length;
const areaCount = (area: (typeof AREAS)[number]) => CERTIFICATES.filter((c) => c.area === area).length;
---
<Base
  title="Sertifikalar · Beyza Nur Kılıç"
  description="Beyza Nur Kılıç'ın sertifikaları ve doğrulama bağlantıları."
  image="/images/sertifikalar/cyberops.webp"
>
  <main class="wrap certs-page">
    <header class="p-top">
      <p class="crumb">Özgeçmiş</p>
      <div class="cert-intro">
        <h1 class="p-title">Sertifikalar</h1>
        <dl class="stat-row">
          <div>
            <dd>{CERTIFICATES.length}</dd>
            <dt>Toplam<span>sertifika</span></dt>
          </div>
          <div>
            <dd>{verifiable}</dd>
            <dt>Doğrulama<span>kurum sitesinde</span></dt>
          </div>
        </dl>
        <p class="lead">
          Ağ ve siber güvenlik, yazılım, yapay zekâ, proje yönetimi ve dil alanlarında aldığım eğitimler. Doğrulama bağlantısı olan
          belgeler, veren kurumun kendi sitesinde kontrol edilebilir.
        </p>
      </div>
    </header>

    <div class="filters" id="cert-filters" role="group" aria-label="Alana göre filtrele">
      <button type="button" data-f="all" aria-pressed="true">Tümü<sup>{CERTIFICATES.length}</sup></button>
      {AREAS.filter((area) => areaCount(area) > 0).map((area) => (
        <button type="button" data-f={area} aria-pressed="false">{area}<sup>{areaCount(area)}</sup></button>
      ))}
    </div>

    <div class="cert-group" data-cert-group>
      <div class="shead" id="belgeler"><h2>Belgeler</h2><span class="label" data-cert-count>{docs.length}</span></div>
      <div class="certs" data-certs>
      {docs.map((c) => (
        <article class="cert" data-area={c.area}>
          {c.parts && c.slug ? (
            <a class="cert-img cert-mosaic" href={`/sertifikalar/${c.slug}`} aria-label={`${c.title} sertifikalarını aç`}>
              {c.parts.map((part) => <img src={part.image} alt="" loading="lazy" decoding="async" />)}
            </a>
          ) : (
            <a class="cert-img" href={c.image} target="_blank" rel="noopener" aria-label={`${c.title} belgesini büyük aç`}>
              <img src={c.image} alt={`${c.title} sertifikası`} loading="lazy" decoding="async" />
            </a>
          )}
          <div class="cert-body">
            <p class="cert-area">{c.area}</p>
            <h3>{c.title}</h3>
            <p class="cert-issuer">{c.issuer}{c.date && <span> · {c.date}</span>}</p>
            {c.detail && <p class="cert-detail">{c.detail}</p>}
            <p class="cert-links">
              {c.verify && <a href={c.verify} target="_blank" rel="noopener">Doğrula ↗</a>}
              {c.parts && c.slug
                ? <a href={`/sertifikalar/${c.slug}`}>Sertifikaları gör</a>
                : <a href={c.image} target="_blank" rel="noopener">Belgeyi görüntüle</a>}
              {c.id && <span class="cert-id">No: {c.id}</span>}
            </p>
          </div>
        </article>
      ))}
      </div>
      <nav class="pager" data-pager hidden aria-label="Belge sayfaları"></nav>
    </div>

    {others.length > 0 && (
      <div class="cert-group" data-cert-group>
        <div class="shead"><h2>Diğer eğitimler</h2><span class="label">belge talep üzerine</span></div>
        <ul class="cert-list">
        {others.map((c) => (
          <li data-area={c.area}>
            <span class="cert-name"><span class="cert-area">{c.area}</span><b>{c.title}</b></span>
            <span class="i">{c.issuer}{c.date && ` · ${c.date}`}</span>
            <span class="v" style="color:var(--ink-3)">{c.detail}</span>
          </li>
        ))}
        </ul>
      </div>
    )}
    <p class="cert-empty" data-cert-empty hidden>Bu alanda belge yok.</p>
  </main>
</Base>

<script>
  const PAGE = 8;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#cert-filters button')];
  const certs = [...document.querySelectorAll<HTMLElement>('.certs .cert')];
  const extras = [...document.querySelectorAll<HTMLElement>('.cert-list [data-area]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-cert-group]')];
  const empty = document.querySelector<HTMLElement>('[data-cert-empty]');
  const countEl = document.querySelector<HTMLElement>('[data-cert-count]');
  const pager = document.querySelector<HTMLElement>('[data-pager]');
  const grid = document.querySelector<HTMLElement>('[data-certs]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let area = 'all';
  let page = 1;
  let generation = 0;

  function matching() {
    return certs.filter((item) => area === 'all' || item.dataset.area === area);
  }

  function tagTransitions(on: boolean) {
    certs.forEach((item, i) => item.style.setProperty('view-transition-name', on ? `cert-${i}` : ''));
    countEl?.style.setProperty('view-transition-name', on ? 'cert-count' : '');
  }

  function drawPager(total: number, pages: number) {
    if (!pager) return;
    pager.hidden = pages <= 1;
    if (pages <= 1) {
      pager.innerHTML = '';
      return;
    }
    const start = (page - 1) * PAGE + 1;
    const end = Math.min(page * PAGE, total);
    const nums = Array.from({ length: pages }, (_, i) => {
      const n = i + 1;
      const current = n === page ? ' aria-current="page"' : '';
      return `<button type="button" data-goto="${n}"${current}>${n}</button>`;
    }).join('');
    pager.innerHTML = `
      <button type="button" data-goto="prev"${page === 1 ? ' disabled' : ''}>Önceki</button>
      <div class="pager-pages">${nums}</div>
      <button type="button" data-goto="next"${page === pages ? ' disabled' : ''}>Sonraki</button>
      <p class="pager-range">${start}–${end} / ${total}</p>`;
  }

  function paint() {
    buttons.forEach((button) => button.setAttribute('aria-pressed', String((button.dataset.f ?? 'all') === area)));
    const shown = matching();
    const pages = Math.max(1, Math.ceil(shown.length / PAGE));
    page = Math.min(Math.max(1, page), pages);
    const from = (page - 1) * PAGE;
    for (const item of certs) {
      const index = shown.indexOf(item);
      const show = index >= from && index < from + PAGE;
      item.hidden = !show;
      if (show) item.classList.add('in');
    }
    for (const item of extras) item.hidden = !(area === 'all' || item.dataset.area === area);
    for (const group of groups) {
      const has = group.querySelector('[data-area]:not([hidden])');
      group.hidden = !has;
    }
    if (countEl) countEl.textContent = String(shown.length);
    if (empty) empty.hidden = shown.length > 0 || extras.some((item) => !item.hidden);
    drawPager(shown.length, pages);
    grid?.classList.add('paged');
    const url = new URL(location.href);
    if (area === 'all') url.searchParams.delete('alan');
    else url.searchParams.set('alan', area);
    if (page === 1) url.searchParams.delete('sayfa');
    else url.searchParams.set('sayfa', String(page));
    history.replaceState(null, '', url);
  }

  function apply(animate = true) {
    const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
    if (!(animate && !reduce && doc.startViewTransition)) {
      paint();
      return;
    }
    const id = ++generation;
    tagTransitions(true);
    document.documentElement.classList.add('vt-filter');
    const transition = doc.startViewTransition(() => paint());
    transition.finished.finally(() => {
      if (id !== generation) return;
      tagTransitions(false);
      document.documentElement.classList.remove('vt-filter');
    });
  }

  function go(next: number) {
    page = next;
    apply(true);
    document.getElementById('belgeler')?.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      area = button.dataset.f ?? 'all';
      page = 1;
      apply(true);
    });
  }

  pager?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('button');
    if (!button || button.hasAttribute('disabled')) return;
    const goto = button.dataset.goto;
    if (goto === 'prev') go(page - 1);
    else if (goto === 'next') go(page + 1);
    else if (goto && Number(goto) !== page) go(Number(goto));
  });

  const params = new URLSearchParams(location.search);
  const wanted = params.get('alan');
  const wantedPage = Number(params.get('sayfa'));
  if (wanted && buttons.some((button) => button.dataset.f === wanted)) area = wanted;
  if (Number.isFinite(wantedPage) && wantedPage > 1) page = Math.floor(wantedPage);
  apply(false);
  if (wanted && area === wanted && !reduce) {
    document.getElementById('cert-filters')?.scrollIntoView({ block: 'start', behavior: 'smooth' });
  }
</script>
